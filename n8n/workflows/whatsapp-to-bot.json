{
  "name": "WhatsApp → BOT_VIAGENS (Infotravel)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook/whatsapp",
        "sendErrors": true
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [0, 200],
      "id": "webhook-whatsapp",
      "name": "Webhook Evolution"
    },
    {
      "parameters": {
        "jsCode": "let numberId = ($json.numberId || '').toString().trim();\nlet text = '';\nif (typeof $json.message === 'object') {\n  text = ($json.message.conversation || '').toString().trim();\n}\nif (!text && typeof $json.text === 'string') { text = $json.text.trim(); }\nreturn [{ json: { numberId: numberId, text: text } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [400, 200],
      "id": "code-normalize",
      "name": "Normaliza webhook"
    },
    {
      "parameters": {
        "url": "{{BOT_SERVICE_URL}}/v1/turn",
        "method": "POST",
        "body": "=JSON.parse(JSON.stringify($json))",
        "returnResponse": true
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [600, 200],
      "id": "http-bot-turn",
      "name": "Chama /v1/turn"
    },
    {
      "parameters": {
        "jsCode": "let actions = Array.isArray($json.action) ? $json.action : [];\nlet sends = [];\nfor (let a of actions) {\n  if (a.type === 'text' && a.text) {\n    sends.push({ to: $json.numberId, text: a.text, buttons: null });\n  }\n  if (a.type === 'buttons' && Array.isArray(a.buttons)) {\n    sends.push({ to: $json.numberId, text: a.text || '', buttons: a.buttons });\n  }\n}\nreturn sends;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [900, 200],
      "id": "code-flattens",
      "name": "Prépara envio"
    },
    {
      "parameters": {
        "itemData": "={{ $json }}"
      },
      "type": "n8n-nodes-base.iterateOverItems",
      "typeVersion": 1,
      "position": [1200, 200],
      "id": "iterate-send",
      "name": "Itera envio"
    },
    {
      "parameters": {
        "url": "{{EVOLUTION_API_URL}}/send-text/{{INSTANCE}}",
        "method": "POST",
        "body": "=JSON.stringify($json.item)",
        "responseFormat": "json"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1500, 200],
      "id": "http-evolution-send",
      "name": "Envio via Evolution"
    },
    {
      "parameters": {
        "respondUsingResponse": false
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1800, 200],
      "id": "respond-ack",
      "name": "Ack (200)",
      "alwaysOutputData": true
    }
  ],
  "connections": {
    "webhook-whatsapp": {
      "main": [
        [
          "code-normalize"
        ]
      ]
    },
    "code-normalize": {
      "main": [
        [
          "http-bot-turn"
        ]
      ]
    },
    "http-bot-turn": {
      "main": [
        [
          "code-flattens"
        ]
      ]
    },
    "code-flattens": {
      "main": [
        [
          "iterate-send"
        ]
      ]
    },
    "iterate-send": {
      "main": [
        [
          "http-evolution-send"
        ]
      ]
    },
    "http-evolution-send": {
      "main": [
        [
          "respond-ack"
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "templateLibrary": {
      "icon": "fa-brands fa-whatsapp",
      "category": "WhatsApp"
    }
  }
}
