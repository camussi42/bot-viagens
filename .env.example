# =====================================================================
# BOT_VIAGENS — copie para ".env" e preencha. Nunca commite o .env.
# Guia detalhado de onde conseguir cada valor: docs/CREDENCIAIS.md
# =====================================================================

# --- Banco de dados / infra local (você define) ---
POSTGRES_USER=bot
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE
POSTGRES_DB=botviagens
# N8N_ENCRYPTION_KEY: gere com:  openssl rand -hex 32   (ou: python -c "import secrets;print(secrets.token_hex(32))")
N8N_ENCRYPTION_KEY=TROQUE_POR_32_BYTES_HEX
EVOLUTION_API_KEY=TROQUE_POR_CHAVE_FORTE

# --- Infotravel (fornecido pela INFOTERA via menu de suporte) ---
# ATENÇÃO: se a senha tiver @ : / ? # & = + troque pelos códigos %40 %3A %2F %3F %23 %26 %3D %2B
# (ela aparece dentro de URLs no docker-compose.yml)
INFOTRAVEL_ENV=homologacao
INFOTRAVEL_DOMAIN=SEU_DOMINIO_HOMOLOG.infotravel.com.br
INFOTRAVEL_USERNAME=seu-usuario
INFOTRAVEL_PASSWORD=sua-senha
INFOTRAVEL_CLIENT=SEU_CLIENT
INFOTRAVEL_AGENCY=2

# --- LLM (extração de slots + redação) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...
# Alternativa gratuita p/ dev: LLM_PROVIDER=gemini  LLM_MODEL=gemini-2.0-flash  LLM_API_KEY=AIza...
